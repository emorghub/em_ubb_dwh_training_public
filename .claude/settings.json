{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(./specs/**)"
    ],
    "deny": [
      "Read(./docs/exercises/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/sql_gate.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
